# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG CPR_BASE_IMAGE=ghcr.io/zyycn/codex-proxy-rs:3.49.0@sha256:74046609022d1249ae34ab7b28dcb23cc97215c3a67dd642663beddf2d5232a5

FROM ${CPR_BASE_IMAGE} AS runtime-base

FROM node:26.13.0-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN npm install --global "$(node -p 'require("./package.json").packageManager')" \
    && pnpm install --frozen-lockfile
COPY frontend ./
ARG CPR_WEB_BASE_PATH=/cprs/
RUN pnpm build --base "$CPR_WEB_BASE_PATH"

FROM runtime-base AS runtime
COPY --from=frontend-builder --chown=10001:10001 /app/frontend/dist /app/web/dist

# 复用已经完成类型检查的前端产物，避免在运行服务器上安装构建依赖
FROM runtime-base AS runtime-prebuilt
COPY --chown=10001:10001 frontend/dist /app/web/dist
